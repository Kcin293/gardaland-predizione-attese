# Copia questo file in .env e personalizza se necessario.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gardaland

# Valori per gli script lanciati fuori da Docker: si collegano al Postgres
# del compose, pubblicato su 5433. Dentro docker-compose questi due vengono
# sovrascritti con db:5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Coordinate Gardaland (Castelnuovo del Garda) per le chiamate Open-Meteo
# e ID del parco su queue-times.com. Oggi i client li tengono hardcoded:
# sono qui come promemoria per quando diventeranno configurabili.
GARDALAND_LAT=45.4544
GARDALAND_LON=10.7139
QUEUE_TIMES_PARK_ID=12
